{
  "name": "@cliparr/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=./src --import tsx ./src/server.ts",
    "build": "tsdown",
    "lint": "pnpm lint:eslint && pnpm lint:types",
    "lint:eslint": "cd ../.. && pnpm exec eslint --config config/eslint.config.js \"apps/server/src/**/*.ts\" \"apps/server/drizzle.config.ts\" \"apps/server/tsdown.config.ts\"",
    "lint:types": "tsc --noEmit",
    "test": "node --expose-gc --import tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:export": "drizzle-kit export --sql",
    "preview": "NODE_ENV=production node --import tsx src/server.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cliparr/shared": "workspace:*",
    "@jellyfin/sdk": "^1.0.0",
    "@logtape/logtape": "^2.3.10",
    "axios": "^1.20.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "express": "^5.2.1",
    "undici": "^7.30.0",
    "@cliparr/plex": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
