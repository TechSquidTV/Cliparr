---
import BaseLayout from "@/components/BaseLayout.astro";
import { recoveryLinks } from "@/lib/notFound";
---

<BaseLayout
  isNotFound
  title="Page not found"
  description="The Cliparr page you requested could not be found."
>
  <section
    class="border-b border-border bg-background py-14 text-foreground sm:py-20"
    aria-labelledby="not-found-title"
  >
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <p class="section-eyebrow">404 — Page not found</p>
        <h1
          id="not-found-title"
          class="mt-5 text-4xl font-semibold leading-tight text-balance sm:text-6xl"
        >
          This page didn’t make<br class="hidden sm:block" /> the final cut.
        </h1>
        <p class="mt-5 text-base leading-7 text-muted-foreground">
          There’s a gap in this timeline. The page may have moved, or the link
          might be out of date.
        </p>
        <div class="missing-timeline" aria-hidden="true">
          <div class="timeline-toolbar">
            <span>Untitled sequence</span>
            <span class="offline-status"><span></span> Clip offline</span>
          </div>
          <div class="timeline-body">
            <div class="timeline-ruler">
              <span>00:00</span><span>00:04</span><span>00:08</span><span
                >00:12</span
              >
            </div>
            <div class="timeline-tracks">
              <div class="video-track">
                <div class="timeline-clip"><span>Intro</span></div>
                <div class="missing-clip">
                  <strong>404</strong><span>Missing clip</span>
                </div>
                <div class="timeline-clip"><span>Outro</span></div>
              </div>
              <div class="audio-track"><span></span><span></span></div>
              <div class="timeline-playhead"></div>
            </div>
          </div>
          <div class="timeline-footer">
            <span>One scene short of a full story.</span><span>00:04:04</span>
          </div>
        </div>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          {
            recoveryLinks.map(({ label, path }, index) => (
              <a
                href={path}
                class:list={[
                  "focus-ring inline-flex min-h-11 items-center justify-center rounded-full px-6 text-sm font-semibold transition-colors",
                  index === 0
                    ? "bg-foreground text-background hover:bg-primary hover:text-primary-foreground"
                    : "border border-border bg-card text-foreground hover:bg-accent",
                ]}
              >
                {label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .missing-timeline {
    margin-top: 2.5rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--card);
    text-align: left;
  }

  .timeline-toolbar,
  .timeline-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .timeline-toolbar {
    border-bottom: 1px solid var(--border);
    font-weight: 500;
  }

  .offline-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .offline-status > span {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--primary);
  }

  .timeline-body {
    padding: 1.25rem;
  }

  .timeline-ruler {
    display: flex;
    justify-content: space-between;
    padding-bottom: 1rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .timeline-tracks {
    position: relative;
  }

  .video-track {
    display: grid;
    grid-template-columns: 1fr 1.35fr 1fr;
    gap: 0.625rem;
  }

  .timeline-clip,
  .missing-clip {
    display: flex;
    min-height: 7rem;
    flex-direction: column;
    justify-content: center;
    border-radius: 0.5rem;
  }

  .timeline-clip {
    justify-content: flex-end;
    padding: 0.75rem;
    border: 1px solid var(--status-ready-border);
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent calc(33.33% - 1px),
        var(--status-ready-border) calc(33.33% - 1px),
        var(--status-ready-border) 33.33%
      ),
      var(--status-ready);
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .missing-clip {
    align-items: center;
    border: 1px dashed var(--muted-foreground);
    background: var(--background);
    color: var(--muted-foreground);
    font-size: 0.6875rem;
  }

  .missing-clip strong {
    color: var(--foreground);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .audio-track {
    display: flex;
    gap: 0.625rem;
    height: 2rem;
    margin-top: 0.625rem;
  }

  .audio-track > span {
    flex: 1;
    border: 1px solid var(--status-ready-border);
    border-radius: 0.375rem;
    background:
      repeating-linear-gradient(
          90deg,
          transparent 0 3px,
          var(--status-ready-border) 3px 5px,
          transparent 5px 8px
        )
        center / 100% 45% no-repeat,
      var(--status-ready);
  }

  .audio-track > span:last-child {
    flex: 0.65;
  }

  .timeline-playhead {
    position: absolute;
    top: -0.625rem;
    bottom: -0.25rem;
    left: 40%;
    width: 2px;
    background: var(--primary);
    animation: find-missing-clip 2.8s ease-out both;
  }

  .timeline-playhead::before {
    position: absolute;
    top: -0.25rem;
    left: -4px;
    width: 10px;
    height: 10px;
    background: var(--primary);
    clip-path: polygon(0 0, 100% 0, 100% 50%, 50% 100%, 0 50%);
    content: "";
  }

  .timeline-footer {
    border-top: 1px solid var(--border);
    font-size: 0.6875rem;
  }

  .timeline-footer > span:last-child {
    font-family: var(--font-mono);
  }

  @keyframes find-missing-clip {
    from {
      transform: translateX(-5rem);
    }
    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-playhead {
      animation: none;
    }
  }
</style>
