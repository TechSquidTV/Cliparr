---
import { Image, Picture } from "astro:assets";

import linuxUnpluggedLogo from "@/assets/blog/cliparr-3-0-release/linux-unplugged-logo.webp";
import mobilePreviewMp4 from "@/assets/mobile-pwa-preview.mp4?url";
import mobilePreviewWebm from "@/assets/mobile-pwa-preview.webm?url";
import mobilePreviewImage from "@/assets/mobile-pwa-preview.webp";
import previewMp4 from "@/assets/preview.mp4?url";
import previewWebm from "@/assets/preview.webm?url";
import screenshotImage from "@/assets/screenshot.webp";
import BaseLayout from "@/components/BaseLayout.astro";
import CommandBlock from "@/components/CommandBlock.astro";
import {
  dockerRunCommandVariants,
  productIntro,
  providers,
  site,
} from "@/data/product";

const asSeenOn = [
  {
    name: "LINUX Unplugged",
    context: "Pick of the week on episode 686",
    href: "https://linuxunplugged.com/686?t=4626",
    logo: linuxUnpluggedLogo,
  },
  {
    name: "selfh.st",
    context: "Listed in the self-hosted apps directory",
    href: "https://selfh.st/apps/?search=cliparr",
    logo: "/selfh-st.svg",
  },
] as const;

const faqs = [
  {
    question: "Where does Cliparr process video?",
    answer:
      "Your browser edits and exports the clip. If you open a file from your device, it stays there. For Plex, Jellyfin, or a direct media URL, your Cliparr server can relay the video to your browser.",
    links: [
      { href: "/docs/local-videos", label: "Local videos and URLs" },
      { href: "/docs/providers", label: "Plex and Jellyfin providers" },
    ],
  },
  {
    question: "What does the Cliparr server do?",
    answer:
      "It connects to Plex and Jellyfin and tells the dashboard what’s playing. It encrypts your saved credentials so it can reconnect later.",
    links: [
      { href: "/docs/providers", label: "Provider setup" },
      { href: "/docs/configuration", label: "Configuration" },
    ],
  },
  {
    question: "Does Cliparr use FFmpeg?",
    answer:
      "No. You can export video, audio, and GIFs without installing FFmpeg, including on your phone and tablet.",
    links: [
      { href: "/docs/export-settings", label: "Export settings" },
      { href: "https://mediabunny.dev/", label: "Mediabunny" },
      { href: "https://github.com/KyleTryon/gifenc", label: "gifenc" },
    ],
  },
  {
    question: "When should I use Cliparr Convert instead?",
    answer:
      "If you need a whole file in another format, open Cliparr Convert in your browser. There’s no server to set up. Use the self-hosted editor to cut a clip or work with a Plex or Jellyfin session.",
    links: [{ href: "/convert", label: "Open Cliparr Convert" }],
  },
] as const;

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${site.url}/#faq`,
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<BaseLayout description={productIntro} structuredData={faqStructuredData}>
  <section class="overflow-hidden border-b border-border bg-background text-foreground">
    <div class="container-page py-8 sm:py-10">
      <div class="mx-auto max-w-4xl text-center">
        <p class="section-eyebrow">Self-hosted video clipping</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight sm:text-6xl">
          Clip what you’re watching.
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-muted-foreground sm:text-xl">
          {productIntro}
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a
            href="/docs/getting-started"
            class="focus-ring inline-flex min-h-11 items-center justify-center rounded-full bg-foreground px-6 text-sm font-semibold text-background transition-colors hover:bg-primary"
          >
            Get started
          </a>
          <a
            href="/try/"
            class="focus-ring inline-flex min-h-11 items-center justify-center rounded-full border border-border bg-card px-6 text-sm font-semibold text-foreground hover:bg-accent"
          >
            Try the editor
          </a>
          <a
            href={site.githubUrl}
            target="_blank"
            rel="noreferrer"
            class="focus-ring inline-flex min-h-11 items-center justify-center rounded-full border border-border bg-card px-6 text-sm font-semibold text-foreground transition-colors hover:bg-accent"
          >
            View on GitHub
          </a>
        </div>
      </div>

      <div class="mx-auto mt-7 max-w-5xl">
        <div class="overflow-hidden rounded-lg border border-[#0A0A0A] bg-[#0A0A0A] p-2 shadow-2xl shadow-black/20">
          <div class="border-b border-white/10 px-3 py-2 text-xs text-white/70">
            <span>Cliparr editor</span>
          </div>
          <div
            class="editor-preview relative overflow-hidden rounded-md bg-[#0A0A0A]"
            data-editor-preview
          >
            <Picture
              src={screenshotImage}
              alt="Cliparr editor showing a video preview, playback controls, and timeline clip selection."
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              width={1600}
              height={886}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 80rem) 1024px, (min-width: 64rem) calc(100vw - 4rem), calc(100vw - 2rem)"
              quality={72}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="block w-full rounded-md"
            />
            <video
              class="editor-preview-video absolute inset-0 h-full w-full rounded-md object-contain"
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
              data-editor-preview-video
            >
              <source data-src={previewWebm} type="video/webm" />
              <source data-src={previewMp4} type="video/mp4" />
            </video>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="scroll-mt-16 bg-background py-12 sm:py-16">
    <div class="container-page grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
      <div class="max-w-xl">
        <div class="mb-6 flex flex-wrap items-center gap-x-7 gap-y-3">
          {providers.map((provider) => (
            <span class="inline-flex items-center gap-2 text-xl font-semibold">
              <img
                src={provider.iconPath}
                alt=""
                width="32"
                height="32"
                class="provider-logo"
              />
              {provider.name}
            </span>
          ))}
        </div>
        <h2 class="text-3xl font-semibold sm:text-5xl">
          Clip a scene and caption it
        </h2>
        <div class="mt-5 space-y-4 text-base leading-7 text-muted-foreground [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-4">
          <p>
            Pick what’s playing on{" "}
            <a href="/docs/providers">Plex or Jellyfin</a>, or open{" "}
            <a href="/docs/local-videos">local videos</a> without uploading
            them. <a href="/docs/video-cropping">Crop it</a>,{" "}
            <a href="/docs/subtitle-burn-in">import and edit subtitles</a> or
            add your own, then{" "}
            <a href="/docs/export-settings">export the clip</a>.
          </p>
          <p>
            Your browser handles the transcoding. Save your clip as MP4, WebM,
            MOV, or MKV, export just the audio, or make a GIF. Work on local
            files offline.
          </p>
        </div>
      </div>
      <figure class="mx-auto w-full max-w-lg">
        <img
          src="/docs/export-dialog.webp"
          alt="Cliparr’s export dialog with MP4 selected, a duration of 2.94 seconds, and one subtitle included."
          width="896"
          height="768"
          loading="lazy"
          decoding="async"
          class="block w-full rounded-lg border border-border"
        />
        <figcaption class="mt-3 text-sm text-muted-foreground">
          The three-second scene above, ready to save as a subtitled 1080p MP4.
          Estimated file size is 2.2 MB.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="border-y border-border bg-muted/40 py-16 sm:py-20">
    <div class="container-page grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div>
        <p class="section-eyebrow">Self-hosted quick start</p>
        <h2 class="mt-5 text-3xl font-semibold sm:text-5xl">
          Run Cliparr with Docker
        </h2>
        <p class="mt-5 text-base leading-7 text-muted-foreground">
          Replace the example <code>APP_KEY</code> with a random secret of at
          least 32 characters. Keep it for future updates. Run the command, then
          open <code>http://localhost:7171</code> on the same computer.
        </p>
      </div>
      <CommandBlock variants={dockerRunCommandVariants} label="Docker" />
    </div>
  </section>

  <section class="bg-background py-16 sm:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,28rem)] lg:items-center">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold sm:text-5xl">
          Runs on all your mobile devices
        </h2>
        <p class="mt-5 text-base leading-7 text-muted-foreground">
          Native-like controls and speed. Clip local files from your camera or
          elsewhere.
        </p>
        <p class="mt-3 text-base leading-7 text-muted-foreground">
          Install the PWA from your browser. On iPhone or iPad, tap Share → Add
          to Home Screen in Safari. On Android, use the install option in a
          supported browser.
        </p>
        <a
          href="/docs/browser-support"
          class="focus-ring mt-8 inline-flex min-h-11 items-center justify-center rounded-full border border-border bg-card px-5 text-sm font-semibold text-foreground transition-colors hover:bg-accent"
        >
          Browser support
        </a>
      </div>

      <div class="flex justify-center lg:justify-end">
        <div class="mobile-phone-preview">
          <div class="editor-preview mobile-phone-screen" data-editor-preview>
            <div class="mobile-phone-content">
              <Picture
                src={mobilePreviewImage}
                alt="Cliparr mobile editor showing a video preview, subtitles, timeline selection, and bottom editing toolbar."
                formats={["avif", "webp"]}
                fallbackFormat="jpg"
                width={mobilePreviewImage.width}
                height={mobilePreviewImage.height}
                widths={[
                  288,
                  336,
                  576,
                  672,
                  864,
                  1008,
                  mobilePreviewImage.width,
                ]}
                sizes="(max-width: 40rem) calc(min(74vw, 18.5rem) - 0.75rem - 2px), calc(22rem - 0.9rem - 2px)"
                quality={72}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
              <video
                class="editor-preview-video absolute inset-0 h-full w-full object-cover"
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
                data-editor-preview-video
              >
                <source data-src={mobilePreviewWebm} type="video/webm" />
                <source data-src={mobilePreviewMp4} type="video/mp4" />
              </video>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-background py-16 sm:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-semibold sm:text-5xl">Cliparr in the wild</h2>
      </div>
      <div class="mx-auto mt-8 grid max-w-4xl gap-4 md:grid-cols-2">
        {asSeenOn.map((mention) => (
          <a
            class="focus-ring rounded-lg border border-border bg-card p-6 transition-colors hover:bg-accent"
            href={mention.href}
            target="_blank"
            rel="noreferrer"
          >
            <div class="flex items-center gap-4">
              <span class="flex h-12 w-12 shrink-0 overflow-hidden rounded-lg border border-border bg-muted">
                {typeof mention.logo === "string" ? (
                  <img
                    src={mention.logo}
                    alt=""
                    width={48}
                    height={48}
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <Image
                    src={mention.logo}
                    alt=""
                    width={48}
                    height={48}
                    densities={[1, 2]}
                    class="h-full w-full object-cover"
                  />
                )}
              </span>
              <div>
                <h3 class="text-lg font-semibold">{mention.name}</h3>
                <p class="mt-1 text-sm leading-6 text-muted-foreground">
                  {mention.context}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-muted/40 py-16 sm:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-semibold sm:text-5xl">
          Frequently asked questions
        </h2>
      </div>
      <div class="mx-auto mt-8 grid max-w-4xl gap-3">
        {faqs.map((faq) => (
          <article class="rounded-lg border border-border bg-card p-5 sm:p-6">
            <h3 class="text-base font-semibold text-foreground">
              {faq.question}
            </h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              {faq.answer}
            </p>
            <div class="mt-3 flex flex-wrap gap-3 text-sm font-medium">
              {faq.links.map((link) => (
                <a
                  class="focus-ring rounded-sm text-foreground underline decoration-border underline-offset-4 hover:decoration-primary"
                  href={link.href}
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                  rel={link.href.startsWith("http") ? "noreferrer" : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        return;
      }

      document.querySelectorAll("[data-editor-preview]").forEach((preview) => {
        const video = preview.querySelector("[data-editor-preview-video]");

        if (!(video instanceof HTMLVideoElement)) {
          return;
        }

        let hasLoadedSources = false;
        const loadSources = () => {
          if (hasLoadedSources) {
            return;
          }

          video.querySelectorAll("source[data-src]").forEach((source) => {
            const src = source.getAttribute("data-src");

            if (src) {
              source.setAttribute("src", src);
            }
          });

          video.load();
          hasLoadedSources = true;
        };

        let wantsPreview = false;

        const playPreview = async () => {
          wantsPreview = true;
          loadSources();

          try {
            await video.play();
            if (wantsPreview) {
              preview.setAttribute("data-playing", "true");
            }
          } catch {
            preview.removeAttribute("data-playing");
          }
        };

        const stopPreview = () => {
          wantsPreview = false;
          video.pause();

          if (video.readyState > 0) {
            video.currentTime = 0;
          }

          preview.removeAttribute("data-playing");
        };

        video.addEventListener("playing", () => {
          if (wantsPreview) {
            preview.setAttribute("data-playing", "true");
          }
        });
        preview.addEventListener("pointerenter", playPreview);
        preview.addEventListener("pointerleave", stopPreview);
      });
    })();
  </script>
</BaseLayout>
