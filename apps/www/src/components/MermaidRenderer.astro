<script>
  let currentRender = 0;

  // Invalidate any in-flight render the moment Astro begins swapping the DOM,
  // so mermaid.run() is never called against detached nodes.
  document.addEventListener("astro:before-swap", () => {
    currentRender++;
  });

  async function renderMermaid() {
    const diagrams = document.querySelectorAll<HTMLPreElement>(
      "pre:has(> code.language-mermaid)",
    );

    if (diagrams.length === 0) {
      return;
    }

    const render = ++currentRender;
    const originalContents = [...diagrams].map((diagram) => ({
      diagram,
      children: [...diagram.childNodes],
    }));

    // Claim the blocks before loading Mermaid so page-load events cannot render
    // them twice. Mermaid reads plain source instead of the code wrapper.
    for (const diagram of diagrams) {
      diagram.classList.add("mermaid");
      diagram.replaceChildren(diagram.textContent);
    }

    let mermaid: typeof import("mermaid").default;
    try {
      ({ default: mermaid } = await import("mermaid"));
    } catch (error) {
      if (render !== currentRender) {
        return;
      }

      for (const { diagram, children } of originalContents) {
        diagram.classList.remove("mermaid");
        diagram.replaceChildren(...children);
      }

      if (reloadAfterImportFailure(error)) {
        return;
      }

      throw error;
    }

    // If navigation started while the async import was in flight, the captured
    // nodes are now detached. Bail out to avoid the null-node crash in d3.
    if (render !== currentRender) {
      return;
    }

    mermaid.initialize({
      flowchart: {
        curve: "basis",
        htmlLabels: false,
      },
      fontFamily: "Outfit Variable, ui-sans-serif, sans-serif",
      startOnLoad: false,
      theme: "base",
      themeVariables: {
        background: "#111111",
        clusterBkg: "#141414",
        clusterBorder: "#4b5563",
        edgeLabelBackground: "#111111",
        lineColor: "#cbd5e1",
        mainBkg: "#1f2937",
        nodeBorder: "#6b7280",
        primaryBorderColor: "#6b7280",
        primaryColor: "#1f2937",
        primaryTextColor: "#f8fafc",
        secondaryBorderColor: "#6b7280",
        secondaryColor: "#111827",
        secondaryTextColor: "#f8fafc",
        textColor: "#f8fafc",
        tertiaryBorderColor: "#6b7280",
        tertiaryColor: "#111827",
        tertiaryTextColor: "#f8fafc",
      },
    });

    await mermaid.run({ nodes: diagrams });
  }

  function reloadAfterImportFailure(error: unknown): boolean {
    if (!(error instanceof TypeError)) {
      return false;
    }

    // Keep the retry across refreshes so persistent fetch failures cannot loop.
    const reloadKey = "cliparr:mermaid-import-reload";
    try {
      if (sessionStorage.getItem(reloadKey) === "1") {
        return false;
      }
      sessionStorage.setItem(reloadKey, "1");
    } catch {
      // Without storage, a reload cannot be bounded safely.
      return false;
    }

    window.location.reload();
    return true;
  }

  document.addEventListener("astro:page-load", renderMermaid);
  void renderMermaid();
</script>
