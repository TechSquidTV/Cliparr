---
import { site } from "@/data/product";
---

<aside class="selfhst-card" aria-label="Cliparr listed on selfh.st">
  <a
    class="selfhst-brand focus-ring"
    href="https://selfh.st/apps/?search=cliparr"
  >
    <img src="/selfh-st.svg" alt="" width="96" height="96" loading="lazy" />
    <span>selfh.st</span>
  </a>

  <div class="listing">
    <div class="listing-header">
      <img
        class="listing-icon"
        src={site.logo}
        alt=""
        width="48"
        height="48"
        loading="lazy"
      />
      <a
        class="listing-name focus-ring"
        href="https://selfh.st/apps/?search=cliparr"
      >
        {site.name}
      </a>
      <svg
        class="bookmark"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M6 3a2 2 0 0 0-2 2v16l8-5 8 5V5a2 2 0 0 0-2-2Z" />
      </svg>
    </div>
    <p class="listing-description">
      Quickly create clips from Plex or Jellyfin media
    </p>
    <div class="listing-details">
      <div class="listing-tags">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
          <path
            fill-rule="evenodd"
            d="M2 4a2 2 0 0 1 2-2h8.9a2 2 0 0 1 1.4.6l6.4 6.4a2 2 0 0 1 0 2.8l-8.1 8.1a2 2 0 0 1-2.8 0l-7.2-7.2a2 2 0 0 1-.6-1.4V4Zm5.5 2.2a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6Z"
          />
        </svg>
        <a
          class="focus-ring"
          href="https://selfh.st/apps/?tag=Media%20Streaming"
        >
          Media Streaming
        </a>
        <span aria-hidden="true">·</span>
        <a class="focus-ring" href="https://selfh.st/apps/?tag=Videos">
          Videos
        </a>
      </div>
      <div class="listing-stats">
        <a
          class="listing-source focus-ring"
          href={site.githubUrl}
          aria-label="Cliparr on GitHub, 186 stars as of October 4, 2026"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
            <path d="M 12 .75 a 11.25 11.25 0 0 0 -3.56 21.92 c .56 .1 .77 -.24 .77 -.54 v -2.1 c -3.13 .68 -3.79 -1.33 -3.79 -1.33 -.51 -1.3 -1.25 -1.65 -1.25 -1.65 -1.02 -.7 .08 -.69 .08 -.69 1.13 .08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27 .93 .1 -.73 .39 -1.22 .71 -1.5 -2.5 -.29 -5.13 -1.25 -5.13 -5.56 0 -1.23 .44 -2.23 1.16 -3.02 -.12 -.29 -.5 -1.43 .11 -2.98 0 0 .95 -.3 3.1 1.15 a 10.8 10.8 0 0 1 5.64 0 c 2.15 -1.46 3.1 -1.15 3.1 -1.15 .61 1.55 .23 2.69 .11 2.98 .72 .79 1.16 1.79 1.16 3.02 0 4.32 -2.63 5.27 -5.14 5.55 .4 .35 .76 1.03 .76 2.08 v 3.11 c 0 .3 .2 .65 .77 .54 A 11.25 11.25 0 0 0 12 .75 Z" />
          </svg>
          <span class="listing-stars">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
              <path d="m12 2 3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.76 5.82 21 7 14.14l-5-4.87 6.91-1.01Z" />
            </svg>
            186
          </span>
        </a>
        <span
          class="listing-activity"
          title="Latest commit shown in the October 4, 2026 listing"
        >
          <span class="activity-dot" aria-hidden="true"></span>
          <time datetime="2026-10-04">2026-10-04</time>
        </span>
      </div>
    </div>
  </div>
</aside>

<style>
  .selfhst-card {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    margin-block: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }
  .selfhst-card a {
    text-decoration: none;
  }
  .selfhst-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    border-radius: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .selfhst-brand img {
    border-radius: 1.125rem;
  }
  .listing {
    min-width: 0;
    padding: 1.5rem;
    border-radius: 1rem;
    background: #222930;
    color: #bfc2c6;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .listing-header,
  .listing-tags,
  .listing-stats,
  .listing-source,
  .listing-stars,
  .listing-activity {
    display: flex;
    align-items: center;
  }
  .listing-header {
    gap: 0.75rem;
  }
  .listing-icon {
    padding: 0.375rem;
    border: 1px solid #353b40;
    border-radius: 0.875rem;
    background: #171b1e;
  }
  .listing .listing-name {
    color: #f5f6f7;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .listing svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .listing .bookmark {
    width: 1.25rem;
    height: 1.5rem;
    color: #3982f7;
  }
  .listing .listing-description {
    margin: 1rem 0 1.5rem;
    color: inherit;
    font-size: 1rem;
    line-height: 1.5;
  }
  .listing-details {
    border-top: 1px solid #353b40;
    padding-top: 0.875rem;
    color: #9ea3a9;
  }
  .listing a {
    color: inherit;
  }
  .listing a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .listing-tags {
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .listing-stats {
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .listing-source,
  .listing-activity {
    gap: 0.5rem;
  }
  .listing-stars {
    gap: 0.125rem;
  }
  .activity-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #48da80;
  }
  @media (max-width: 40rem) {
    .selfhst-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      padding: 1rem;
    }
    .selfhst-brand {
      flex-direction: row;
      justify-self: start;
    }
    .selfhst-brand img {
      width: 3rem;
      height: 3rem;
      border-radius: 0.625rem;
    }
    .listing {
      padding: 1.25rem;
    }
  }
</style>
