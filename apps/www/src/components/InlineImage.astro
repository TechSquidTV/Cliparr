---
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  size?: number;
}

const { src, alt, size = 1.75 } = Astro.props;
---

<img
  src={src.src}
  alt={alt}
  width={src.width}
  height={src.height}
  class="inline-image"
  style={{ "--inline-image-size": `${size}em` }}
  decoding="async"
/>

<style>
  .inline-image {
    display: inline-block;
    width: auto;
    height: var(--inline-image-size);
    margin: 0;
    vertical-align: middle;
  }
</style>
