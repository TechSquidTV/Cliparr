{
  "name": "@cliparr/frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "exports": {
    "./convert": {
      "types": "./src/convert.ts",
      "default": "./src/convert.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "pnpm lint:eslint && pnpm lint:types",
    "lint:eslint": "cd ../.. && pnpm exec eslint --config config/eslint.config.js \"apps/frontend/src/**/*.{ts,tsx}\" \"apps/frontend/vite.config.js\" \"apps/frontend/public/service-worker.js\" \"apps/frontend/tests/**/*.{ts,mjs}\"",
    "lint:types": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"tests/*.test.mjs\" \"../../tools/ci/media-loading-lint.test.mjs\"",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "test:browser": "node tests/audio-export.mjs",
    "test:browser:loading": "node tests/media-loading.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cliparr/shared": "workspace:*",
    "@logtape/logtape": "^2.3.10",
    "@mediabunny/aac-encoder": "1.61.0",
    "@mediabunny/ac3": "1.61.0",
    "@mediabunny/flac-encoder": "1.61.0",
    "@mediabunny/mp3-encoder": "1.61.0",
    "@tanstack/react-router": "^1.170.41",
    "@techsquidtv/canvas-timeline": "^0.4.0",
    "@techsquidtv/canvas-timeline-mediabunny-adapter": "^0.4.0",
    "@techsquidtv/gifenc": "1.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.50.0",
    "mediabunny": "1.61.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "playwright": "1.63.0"
  }
}
