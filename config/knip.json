{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["."],
  "workspaces": {
    "apps/frontend": {
      "entry": [
        "src/main.tsx",
        "src/styles/motionTheme.ts",
        "vite.config.js",
        "tests/audio-export.ts",
        "tests/media-loading.ts"
      ],
      "ignoreBinaries": ["eslint"],
      "project": ["src/**/*.{ts,tsx,css}", "tests/**/*.{ts,mjs}"],
      "vite": false
    },
    "apps/www": {
      "entry": ["src/worker.ts", "src/components/AudioPlayer.astro"],
      "ignoreDependencies": [
        "@fontsource-variable/outfit",
        "@mediabunny/aac-encoder",
        "@mediabunny/ac3",
        "@techsquidtv/gifenc",
        "tailwindcss"
      ],
      "ignoreBinaries": ["eslint"],
      "project": ["src/**/*.{astro,mdx,ts,tsx}", "scripts/**/*.ts"]
    },
    "apps/server": {
      "drizzle": false,
      "ignoreBinaries": ["eslint"],
      "paths": {
        "@/*": ["./src/*"]
      },
      "project": ["src/**/*.ts"]
    },
    "packages/shared": {
      "ignoreBinaries": ["eslint", "tsc"],
      "project": ["src/**/*.{js,ts}"]
    },
    "tools/www-assets": {
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["eslint"]
    },
    "packages/plex": {
      "ignore": ["src/generated/**"],
      "ignoreBinaries": ["tsc", "eslint"],
      "project": ["src/**/*.ts"]
    }
  }
}
