{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    "security:minimumReleaseAgeNpm",
    "docker:pinDigests"
  ],
  "timezone": "America/New_York",
  "schedule": ["* 0-4 * * 6"],
  "configMigration": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "cliparr",
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track pinned container images in deployment documentation.",
      "managerFilePatterns": ["/^apps/www/src/content/docs/.+\\.mdx$/"],
      "matchStrings": [
        "image:[ \\t]+(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "groupName": "Documentation container images",
      "semanticCommitType": "docs"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm dependencies"
    },
    {
      "matchManagers": ["docker-compose", "dockerfile"],
      "groupName": "Docker images",
      "semanticCommitType": "build",
      "description": "Provider images are development and capture fixtures."
    },
    {
      "description": "Production base and build image updates must be included in the next app release.",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["docker/Dockerfile"],
      "groupName": "Application container images",
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "semanticCommitType": "ci"
    },
    {
      "description": "Local image names are build outputs, not registry dependencies.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cliparr-dev", "cliparr-www-capture"],
      "enabled": false
    },
    {
      "description": "Distroless encodes Node and Debian majors in its image name; track its digest.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["gcr.io/distroless/nodejs24-debian13"],
      "versioning": "loose"
    },
    {
      "description": "Plex release tags have four numeric components and a build hash.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["plexinc/pms-docker"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[a-f0-9]+$"
    }
  ]
}
